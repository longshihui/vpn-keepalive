{
  "name": "vpn-keepalive",
  "version": "0.2.0",
  "description": "可配置多地址的 HTTP 保活工具，本地 Web 界面配置，npx 直接运行",
  "type": "module",
  "bin": {
    "vpn-keepalive": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "tsc && vite build web && node scripts/finish-build.mjs",
    "prepack": "pnpm run build",
    "verify:integration": "pnpm run build && node scripts/verify-integration.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "naive-ui": "^2.45.3",
    "prettier": "^3.8.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
