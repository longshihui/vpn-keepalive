{
  "name": "vpn-keepalive",
  "version": "0.2.0",
  "description": "可配置多地址的 HTTP 保活工具，本地 Web 界面配置，npx 直接运行",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longshihui/vpn-keepalive.git"
  },
  "type": "module",
  "bin": {
    "vpn-keepalive": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts --data-dir ./.dev-data --port 3888",
    "dev:web": "vite web",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "tsc && vite build web && node scripts/finish-build.mjs",
    "prepack": "pnpm run build",
    "verify:integration": "pnpm run build && node scripts/verify-integration.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.0",
    "@release-it/bumper": "^7.0.6",
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "czg": "^1.14.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "naive-ui": "^2.45.3",
    "prettier": "^3.8.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "commander": "^15.0.0",
    "get-port": "^7.2.0"
  }
}